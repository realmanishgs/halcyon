{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core events, native open dialogs, native context menu, fullscreen and focus. No filesystem or shell access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-focus",
    "core:webview:allow-set-webview-focus",
    "dialog:allow-open"
  ]
}
