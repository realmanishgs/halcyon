{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halcyon",
  "version": "0.1.0",
  "identifier": "app.halcyon.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Halcyon", "width": 1200, "height": 720, "minWidth": 720, "minHeight": 480, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost",
      "assetProtocol": { "enable": true, "scope": ["$CONFIG/vlc/art/**"] }
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico", "icons/icon.png"] }
}
